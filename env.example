# ===== 云端中台 .env 模板 =====
# 用法：复制为 .env 后填值。带 ★ 的是"需要你提供"；其余可用默认/我生成。

# ---------- 应用 ----------
APP_NAME=listing-hub
APP_ENV=production
APP_KEY=                        # php artisan key:generate 自动生成（不用填）
APP_URL=https://hub.weixiubang.club   # ★ 中台 Web/API 访问地址
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
APP_DEBUG=false

# ---------- MySQL（自建·仅内网） ----------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=listing_hub
DB_USERNAME=listing_hub
DB_PASSWORD=                    # ★ 数据库口令（可我给你生成）

# ---------- Redis（队列/缓存·自建·仅内网） ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                 # ★ Redis 口令（可我给你生成）
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ---------- 阿里云 OSS（媒体图床） ----------
OSS_ACCESS_KEY_ID=              # ★ RAM 子账号 AccessKeyId（仅授权该 Bucket）
OSS_ACCESS_KEY_SECRET=          # ★ 对应 Secret（可你先自己填 .env，不必发我）
OSS_BUCKET=listing-hub
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com          # 中国香港
# 跨区（大陆 ECS ↔ 香港 OSS）→ 无内网，留空：
OSS_INTERNAL_ENDPOINT=
OSS_PATH_PREFIX=blobs

# ---------- 媒体对外（域名/CDN） ----------
# 当前选：方案A —— 直接用 OSS 自带域名（需关闭"阻止公共访问" + Bucket 公共读）
# 以后想上 CDN/自有域名：改走方案B（注释里那种），存 storage_key 渲染 URL，零改库
OSS_CDN_DOMAIN=                # 方案A 留空；方案B 填 media.weixiubang.club
MEDIA_PUBLIC_BASE_URL=https://listing-hub.oss-cn-hongkong.aliyuncs.com   # 方案A（OSS 默认域）；方案B 改 https://media.weixiubang.club
MEDIA_ALLOWED_HOSTS=listing-hub.oss-cn-hongkong.aliyuncs.com   # 自有/自有化域名白名单（图片URL归一幂等用）；方案B 再加 media.weixiubang.club

# ---------- 鉴权 ----------
SANCTUM_STATEFUL_DOMAINS=hub.weixiubang.club    # ★ 与 APP_URL 同域

# ---------- 备份 / 邮件（可选） ----------
BACKUP_DISK=oss
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hub@weixiubang.club
