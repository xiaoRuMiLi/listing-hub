APP_NAME=listing-hub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN

LOG_CHANNEL=stack

# 数据库（本地 PHPstudy MySQL5.7 / 生产 MySQL8）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=listing_hub
DB_USERNAME=root
DB_PASSWORD=

# Redis（本地可空；生产 redis）
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 阿里云 OSS（媒体图床）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=listing-hub
OSS_ENDPOINT=oss-cn-hongkong.aliyuncs.com
OSS_INTERNAL_ENDPOINT=
OSS_PATH_PREFIX=blobs

# 媒体对外（方案A：OSS 默认域名；方案B：media.weixiubang.club + CDN）
OSS_CDN_DOMAIN=
MEDIA_PUBLIC_BASE_URL=https://listing-hub.oss-cn-hongkong.aliyuncs.com
MEDIA_ALLOWED_HOSTS=listing-hub.oss-cn-hongkong.aliyuncs.com

# 鉴权
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,hub.weixiubang.club
